{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tv-program-weekly-sync",
  "main": "api/worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tv-program-weekly-data",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": false
  }
}
